# ── TobiaszCRM — zmienne środowiskowe ──────────────────────────────
# Skopiuj ten plik do `.env` i uzupełnij wartości. NIE commituj `.env`.

# Baza danych
# Lokalnie (SQLite):
DATABASE_URL="file:./dev.db"
# Produkcja (Neon Postgres) — przykład:
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/tobiaszcrm?sslmode=require"

# Hasło do aplikacji (jedno hasło, aplikacja jednoużytkownikowa).
# Wygeneruj hash bcrypt: `node scripts/hash-password.mjs "twoje-haslo"`
#
# UWAGA: w pliku .env znaki `$` MUSZĄ być poprzedzone backslashem (`\$`),
# bo Next.js rozwija zmienne w wartościach i niezescapowany hash bcrypt
# (postaci $2a$10$...) zostanie zepsuty → „Błędne hasło" przy logowaniu.
# W panelu Vercel wklejasz hash BEZ escapowania.
# Przykład: AUTH_PASSWORD_HASH="\$2a\$10\$abcdef..."
AUTH_PASSWORD_HASH=""

# Sekret do podpisywania sesji (min. 32 znaki, losowy).
# Wygeneruj: `openssl rand -base64 48`
AUTH_SECRET=""

# Strefa czasowa (nie zmieniaj bez potrzeby)
TZ="Europe/Warsaw"
